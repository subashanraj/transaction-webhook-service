# Copy to .env and fill in the password. Never commit .env.
# Percent-encode special characters in the password: @ -> %40, # -> %23, / -> %2F, : -> %3A

# Supabase project mcruwfsabafonhdlyjjz (region ap-northeast-2, Seoul).
# Direct connection - IPv6 only. Works from a local machine with IPv6:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.mcruwfsabafonhdlyjjz.supabase.co:5432/postgres?sslmode=require
# Session pooler - IPv4. REQUIRED on Render/Railway (no IPv6 egress). Copy the exact
# host from Supabase dashboard > Connect > Session pooler; it looks like:
# DATABASE_URL=postgresql://postgres.mcruwfsabafonhdlyjjz:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
# Transaction pooler (port 6543) also works if you set DB_STATEMENT_CACHE_SIZE=0.
# Local Postgres:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webhooks

PROCESSING_DELAY_SECONDS=30
WORKER_CONCURRENCY=100
POLL_INTERVAL_SECONDS=1
LEASE_SECONDS=90
MAX_ATTEMPTS=5
RETRY_BASE_SECONDS=2
RETRY_MAX_SECONDS=300
DB_WRITE_TIMEOUT_MS=400
DB_STATEMENT_CACHE_SIZE=100
DB_API_POOL_SIZE=10
DB_WORKER_POOL_SIZE=5
INTAKE_FLUSHERS=4
INTAKE_MAX_BATCH=500
AUTO_MIGRATE=true
WEBHOOK_SECRET=
SIMULATED_FAILURE_RATE=0
LOG_LEVEL=INFO
